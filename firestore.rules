rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isVerifiedWmuUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@wmich[.]edu');
    }

    function isOwner(uid) {
      return isVerifiedWmuUser() && request.auth.uid == uid;
    }

    function isString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function isRequiredString(value, maxLength) {
      return isString(value, maxLength) && value.size() > 0;
    }

    function isValidProfile(data) {
      return data.keys().hasOnly(['firstName', 'lastName', 'preferredName', 'joinedTerm', 'requirements', 'updatedAt'])
        && data.keys().hasAll(['firstName', 'lastName', 'preferredName', 'joinedTerm', 'requirements', 'updatedAt'])
        && isRequiredString(data.firstName, 60)
        && isRequiredString(data.lastName, 60)
        && isRequiredString(data.preferredName, 60)
        && isRequiredString(data.joinedTerm, 20)
        && data.requirements is map
        && data.requirements.size() <= 10
        && data.updatedAt == request.time;
    }

    function isValidOrganization(data) {
      return data.keys().hasOnly(['name', 'contactName', 'mailingAddress', 'contactInfo', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['name', 'contactName', 'mailingAddress', 'contactInfo', 'createdAt', 'updatedAt'])
        && isRequiredString(data.name, 120)
        && isString(data.contactName, 120)
        && isString(data.mailingAddress, 300)
        && isString(data.contactInfo, 150)
        && data.updatedAt == request.time;
    }

    function isValidFlags(flags) {
      return flags is list
        && flags.size() <= 8
        && flags.hasOnly(['notNonprofit', 'paid', 'internship', 'rsoInternal', 'politicalReligious', 'donation', 'participant', 'development']);
    }

    function isValidSession(uid, data) {
      return data.keys().hasOnly(['orgId', 'date', 'hours', 'activity', 'flags', 'favorite', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['orgId', 'date', 'hours', 'activity', 'flags', 'createdAt', 'updatedAt'])
        && isRequiredString(data.orgId, 64)
        && exists(/databases/$(database)/documents/users/$(uid)/organizations/$(data.orgId))
        && data.date is string
        && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.hours is number
        && data.hours > 0
        && data.hours <= 24
        && isRequiredString(data.activity, 500)
        && isValidFlags(data.flags)
        && (!('favorite' in data) || data.favorite is bool)
        && data.updatedAt == request.time;
    }

    function isValidDraft(draftId, data) {
      return data.keys().hasOnly(['year', 'orgId', 'description', 'impact', 'updatedAt'])
        && data.keys().hasAll(['year', 'orgId', 'description', 'impact', 'updatedAt'])
        && data.year is string
        && data.year.matches('[0-9]{4}-[0-9]{4}')
        && isRequiredString(data.orgId, 64)
        && draftId == data.year + '_' + data.orgId
        && isString(data.description, 3000)
        && isString(data.impact, 3000)
        && data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidProfile(request.resource.data);
      allow delete: if isOwner(uid);

      match /organizations/{orgId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && isValidOrganization(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid)
          && isValidOrganization(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(uid);
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && isValidSession(uid, request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid)
          && isValidSession(uid, request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(uid);
      }

      match /drafts/{draftId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidDraft(draftId, request.resource.data);
        allow delete: if isOwner(uid);
      }
    }
  }
}